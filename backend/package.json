{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "URL Shortener REST API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "worker": "ts-node-dev --transpile-only src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "nanoid": "^3.3.7",
    "pg": "^8.12.0",
    "stripe": "^23.0.0",
    "ua-parser-js": "^1.0.41",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "@types/ua-parser-js": "^0.7.39",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  }
}
