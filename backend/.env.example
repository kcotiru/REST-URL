PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# App
BASE_URL=http://localhost:3000
SHORT_CODE_LENGTH=7

# Supabase (JWKS is fetched from here to verify access tokens)
SUPABASE_URL=https://your-project.supabase.co

# Redis (rate limiting + redirect cache; the API still works if it is down)
REDIS_URL=redis://localhost:6379
# Number of reverse proxies in front of the app (e.g. 1); needed so rate limits see real client IPs
TRUST_PROXY=

# CORS allowed origin
FRONTEND_ORIGIN=http://localhost:5173
